# Required private PostgreSQL connection. Never commit a real URL/password.
DATABASE_URL=postgresql://curator:replace-me@localhost:5432/curator
# Optional CA certificate for PostgreSQL deployments that require verified TLS.
CURATOR_DATABASE_CA_FILE=
# Optional Mac SSH tunnel. DATABASE_URL must point to its loopback local port.
CURATOR_DATABASE_SSH_TARGET=
CURATOR_DATABASE_REMOTE_HOST=
CURATOR_DATABASE_REMOTE_PORT=
CURATOR_DATA_DIR=./data
# Optional private worker-only JSON settings file (machine-specific paths/commands).
CURATOR_WORKER_CONFIG_FILE=
CURATOR_BASE_URL=http://localhost:3000
# Comma-separated browser origins accepted by Better Auth.
CURATOR_TRUSTED_ORIGINS=http://localhost:3000
# Comma-separated hostnames/IPs allowed to load Next.js development assets.
CURATOR_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1
# Optional deployment override. Normal local installations generate a secret file.
BETTER_AUTH_SECRET=
# Optional Nominatim-compatible search endpoint; public OSM is used by default.
# Lookup is user-triggered and cached, with a shared 1 request/second limit.
CURATOR_GEOCODING_URL=https://nominatim.openstreetmap.org/search
# Optional OSM-compatible raster tile URL. Do not put private tokens here.
# Mapbox public tokens are entered per user in the map UI, stored only locally.
CURATOR_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
